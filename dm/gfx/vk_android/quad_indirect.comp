// PEANUTS: indirect quads on the GPU. NVN's indirect draws of quads, converted on the GPU. Each record { count, instances, first, base instance } (nvnCommandBufferDrawArraysIndirect,
// copied into the buffer at word i * 4) becomes the { index count, instances, first index, vertex offset, base instance } of an indexed indirect draw over the shared quad
// index buffer (index 6 q + j holds 4 q + {0, 1, 2, 0, 2, 3}[j]), written at word g.dst + i * 5. A first vertex that is a multiple of 4 becomes a first index, so the
// vertex indices are first + i as NVN's are and the base vertex 0, as the CPU expansion (vka_draw.c) has them; any other first, or one whose first index would run past
// the shared buffer's g.cap indices, goes into the vertex offset instead. Only a draw of more than g.cap indices on its own is not drawn.
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Records { uint w[]; } b;
layout(push_constant) uniform Args { uint n, cap, dst; } g;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= g.n) return;
    uint count = b.w[i * 4u], inst = b.w[i * 4u + 1u], first = b.w[i * 4u + 2u], binst = b.w[i * 4u + 3u];
    uint ic = 0u, fi = 0u, vo = first;
    if ((count >> 2) > g.cap / 6u) inst = 0u;   // (count >> 2) * 6 past the buffer, or past 32 bits
    else ic = (count >> 2) * 6u;
    if (ic != 0u && (first & 3u) == 0u && (first >> 2) <= g.cap / 6u && (first >> 2) * 6u <= g.cap - ic) { fi = (first >> 2) * 6u; vo = 0u; }
    uint o = g.dst + i * 5u;
    b.w[o] = ic; b.w[o + 1u] = inst; b.w[o + 2u] = fi; b.w[o + 3u] = vo; b.w[o + 4u] = binst;
}
